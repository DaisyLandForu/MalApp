# Copy this file to .env on server 83.
# Current hybrid deployment:
# - Model A runs on 10.0.11.55 and is configured in the APP.
# - Server 83 only hosts Model B, the adversarial reviewer.

VLLM_IMAGE=vllm/vllm-openai:v0.8.5
HF_HOME=/data/malapp-models/huggingface
MODEL_DIR=/data/models
HF_TOKEN=
ENABLE_MODEL_A=0

# Model A is disabled by default on 83. Keep these values only for emergency single-host tests.
MODEL_A_ID=/models/Qwen3-14B
MODEL_A_NAME=malapp-model-a
MODEL_A_PORT=8011
MODEL_A_GPU_MEMORY_UTILIZATION=0.58

# Model B uses the local Qwen3-14B directory and is loaded as runtime 4-bit by vLLM bitsandbytes.
MODEL_B_ID=/models/Qwen3-14B
MODEL_B_NAME=malapp-model-b
MODEL_B_PORT=8012
MODEL_B_GPU_MEMORY_UTILIZATION=0.86

MAX_MODEL_LEN=2048
MODEL_A_MAX_MODEL_LEN=4096
MODEL_B_MAX_MODEL_LEN=4096
MAX_NUM_SEQS=1
