MALAPP_PUBLISHED_PORT=8765
MALAPP_DEBATE_ROUNDS=2

# Keep disabled in the lightweight application image.
MALAPP_USE_LOCAL_QWEN=0
MALAPP_QWEN_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# OpenAI-compatible model A.
MALAPP_MODEL_A_API_URL=http://host.docker.internal:8001/v1
MALAPP_MODEL_A_API_KEY=replace-model-a-key
MALAPP_MODEL_A_MODEL=model-a

# OpenAI-compatible model B.
MALAPP_MODEL_B_API_URL=http://host.docker.internal:8002/v1
MALAPP_MODEL_B_API_KEY=replace-model-b-key
MALAPP_MODEL_B_MODEL=model-b
