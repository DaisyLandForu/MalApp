# Your model must expose an OpenAI-compatible /v1 API and support tool calling.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=replace-with-your-key
HERMES_MODEL=malapp-agent

# Existing local judgement service.
MALAPP_API_BASE=http://127.0.0.1:8765

# Optional local Qwen fallback used by the existing debate pipeline.
MALAPP_USE_LOCAL_QWEN=1
MALAPP_QWEN_MODEL=Qwen/Qwen2.5-0.5B-Instruct
