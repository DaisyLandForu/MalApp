MALAPP_PROFILE=demo
MALAPP_PUBLISHED_PORT=8765
MALAPP_DEBATE_ROUNDS=2

# Set to [ml] when the image must include XGBoost runtime support.
MALAPP_EXTRAS=

# Keep both remote and local models disabled for the deterministic demo profile.
MALAPP_USE_SERVER_MODELS=0
MALAPP_USE_LOCAL_QWEN=0
MALAPP_QWEN_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# OpenAI-compatible model A.
MALAPP_MODEL_A_API_URL=
MALAPP_MODEL_A_API_KEY=
MALAPP_MODEL_A_MODEL=

# OpenAI-compatible model B.
MALAPP_MODEL_B_API_URL=
MALAPP_MODEL_B_API_KEY=
MALAPP_MODEL_B_MODEL=
